# Copy this file to .env before using Docker Compose in production.
FRONTEND_PORT=3000
BACKEND_PORT=8080

MYSQL_DATABASE=fire_monitoring
MYSQL_USER=fire_monitor
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# Must contain at least 32 UTF-8 bytes. Use a long random value in production.
FIRE_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
FIRE_JWT_ISSUER=fire-monitoring-system
FIRE_JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000
JPA_DDL_AUTO=update

MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_CLIENT_ID=fire-monitoring-docker
MQTT_PORT=1883
MQTT_USERNAME=fire_monitor
MQTT_PASSWORD=replace-with-a-strong-mqtt-password

# Internal Docker URL used by the Spring Boot backend.
PREDICTION_BASE_URL=http://prediction:8000
